    {
        "id": "func_c_wss",
        "type": "function",
        "z": "tab_project_c_wss",
        "name": "整理全班訊息流與活躍節點",
        "func": "const parts = msg.topic.split('/');\nconst sender = parts[1] || 'unknown';\nconst category = parts[3] || 'general';\nconst timeStr = new Date().toLocaleTimeString('zh-TW', { hour12: false });\n\nlet history = flow.get('c_history') || [];\nlet users = flow.get('c_users') || {};\nlet counts = flow.get('c_counts') || { announcement: 0, alert: 0, status: 0, total: 0 };\n\ncounts.total += 1;\nif (counts[category] !== undefined) {\n    counts[category] += 1;\n}\n\nusers[sender] = {\n    name: sender,\n    lastSeen: timeStr,\n    lastCategory: category,\n    msgCount: (users[sender] ? users[sender].msgCount : 0) + 1\n};\n\nhistory.unshift({\n    topic: msg.topic,\n    sender: sender,\n    category: category,\n    payload: typeof msg.payload === 'object' ? JSON.stringify(msg.payload) : String(msg.payload),\n    time: timeStr\n});\nif (history.length > 25) history.pop();\n\nflow.set('c_history', history);\nflow.set('c_users', users);\nflow.set('c_counts', counts);\n\nmsg.payload = {\n    history: history,\n    users: Object.values(users),\n    counts: counts\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 140,
        "wires": [
            [
                "ui_template_c_wss"
            ]
        ]
    },
    {
        "id": "ui_template_c_wss",
        "type": "ui_template",
        "z": "tab_project_c_wss",
        "group": "ui_group_c_wss",
        "name": "全班訊息廣播系統介面",
        "order": 1,
        "width": "24",
        "height": "14",
        "format": "<style>\n  .shiftr-board {\n    background-color: #1db96b;\n    color: #062b18;\n    font-family: 'Consolas', 'Monaco', 'Microsoft JhengHei', monospace;\n    padding: 16px;\n    border-radius: 6px;\n    display: grid;\n    grid-template-columns: 310px 1fr 250px;\n    gap: 16px;\n    min-height: 620px;\n    box-sizing: border-box;\n  }\n  .shiftr-col-title {\n    font-size: 13px;\n    font-weight: bold;\n    margin-bottom: 10px;\n    color: #07361e;\n    display: flex;\n    justify-content: space-between;\n  }\n  .shiftr-card {\n    background-color: #26cc79;\n    border: 1px solid #169e5a;\n    padding: 10px 12px;\n    margin-bottom: 8px;\n    border-radius: 3px;\n  }\n  .shiftr-topic {\n    font-size: 11px;\n    font-weight: bold;\n    color: #052e19;\n    word-break: break-all;\n  }\n  .shiftr-val {\n    font-size: 14px;\n    font-weight: bold;\n    margin: 4px 0;\n    color: #021a0e;\n  }\n  .shiftr-meta {\n    font-size: 10px;\n    color: #0b4f2d;\n  }\n  .shiftr-center {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: space-between;\n  }\n  .shiftr-header {\n    text-align: center;\n    margin-bottom: 6px;\n  }\n  .shiftr-header h2 {\n    margin: 0;\n    font-size: 18px;\n    color: #042414;\n  }\n  .shiftr-header p {\n    margin: 2px 0 0 0;\n    font-size: 12px;\n    color: #0b4f2d;\n  }\n  .shiftr-svg-wrap {\n    width: 100%;\n    flex: 1;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .shiftr-pub-panel {\n    width: 100%;\n    background: #26cc79;\n    border: 1px solid #148f51;\n    padding: 12px;\n    border-radius: 4px;\n    box-sizing: border-box;\n  }\n  .shiftr-row {\n    display: flex;\n    gap: 8px;\n    margin-bottom: 8px;\n  }\n  .shiftr-input {\n    flex: 1;\n    background: #a6f2cb;\n    border: 1px solid #148f51;\n    color: #042414;\n    padding: 7px 10px;\n    border-radius: 3px;\n    font-family: inherit;\n    font-size: 13px;\n  }\n  .shiftr-btn {\n    border: none;\n    padding: 8px 12px;\n    border-radius: 3px;\n    font-weight: bold;\n    cursor: pointer;\n    font-family: inherit;\n    font-size: 12px;\n  }\n  .shiftr-btn:hover { opacity: 0.85; }\n  .btn-ann { background: #07361e; color: #26cc79; }\n  .btn-alt { background: #b71c1c; color: #ffffff; }\n  .btn-sta { background: #0d47a1; color: #ffffff; }\n  .badge-cat {\n    display: inline-block;\n    padding: 1px 6px;\n    border-radius: 2px;\n    font-size: 10px;\n    color: #fff;\n    margin-right: 4px;\n  }\n  .cat-announcement { background: #07361e; }\n  .cat-alert { background: #b71c1c; }\n  .cat-status { background: #0d47a1; }\n</style>\n\n<div class=\"shiftr-board\">\n  <div>\n    <div class=\"shiftr-col-title\">\n      <span>Last Messages</span>\n      <span>Total: {{data.counts.total}}</span>\n    </div>\n    <div class=\"shiftr-card\">\n      <div class=\"shiftr-meta\">Wildcard: <b>AIOT/+/message/#</b></div>\n      <div style=\"font-size:11px; margin-top:4px;\">\n        公告: <b>{{data.counts.announcement}}</b> ｜ 警報: <b>{{data.counts.alert}}</b> ｜ 狀態: <b>{{data.counts.status}}</b>\n      </div>\n    </div>\n    <div style=\"max-height: 500px; overflow-y: auto;\">\n      <div class=\"shiftr-card\" ng-repeat=\"item in data.history\">\n        <div class=\"shiftr-topic\">\n          <span class=\"badge-cat cat-{{item.category}}\">{{item.category}}</span>{{item.topic}}\n        </div>\n        <div class=\"shiftr-val\">{{item.payload}}</div>\n        <div class=\"shiftr-meta\">{{item.sender}} &nbsp; {{item.time}} &nbsp; QoS 0</div>\n      </div>\n      <div class=\"shiftr-card\" ng-if=\"data.history.length === 0\">\n        <div class=\"shiftr-meta\">連線成功後，全班廣播訊息將即時顯示於此...</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"shiftr-center\">\n    <div class=\"shiftr-header\">\n      <h2>AIOT 全班訊息廣播系統 (user8)</h2>\n      <p>wss://mqtt.ridgerealm.com/mqtt &nbsp;|&nbsp; Wildcard: AIOT/+/message/#</p>\n    </div>\n\n    <div class=\"shiftr-svg-wrap\">\n      <svg viewBox=\"0 0 420 280\" width=\"100%\" height=\"270\">\n        <g stroke=\"#0a4728\" stroke-width=\"1.2\" stroke-dasharray=\"4,3\" opacity=\"0.7\">\n          <line x1=\"210\" y1=\"140\" x2=\"100\" y2=\"55\" />\n          <line x1=\"210\" y1=\"140\" x2=\"320\" y2=\"55\" />\n          <line x1=\"210\" y1=\"140\" x2=\"80\" y2=\"145\" />\n          <line x1=\"210\" y1=\"140\" x2=\"340\" y2=\"145\" />\n          <line x1=\"210\" y1=\"140\" x2=\"110\" y2=\"225\" />\n          <line x1=\"210\" y1=\"140\" x2=\"310\" y2=\"225\" />\n        </g>\n        <g stroke=\"#042414\" stroke-width=\"2\">\n          <line x1=\"210\" y1=\"140\" x2=\"130\" y2=\"90\" />\n          <line x1=\"210\" y1=\"140\" x2=\"290\" y2=\"90\" />\n          <line x1=\"210\" y1=\"140\" x2=\"210\" y2=\"220\" />\n        </g>\n        <circle cx=\"210\" cy=\"140\" r=\"22\" fill=\"#1db96b\" stroke=\"#042414\" stroke-width=\"3\" />\n        <text x=\"210\" y=\"144\" text-anchor=\"middle\" font-size=\"10\" font-weight=\"bold\" fill=\"#042414\">BROKER</text>\n\n        <circle cx=\"130\" cy=\"90\" r=\"8\" fill=\"#07361e\" />\n        <text x=\"115\" y=\"78\" text-anchor=\"end\" font-size=\"11\" font-weight=\"bold\" fill=\"#042414\">announcement</text>\n\n        <circle cx=\"290\" cy=\"90\" r=\"8\" fill=\"#b71c1c\" />\n        <text x=\"305\" y=\"78\" text-anchor=\"start\" font-size=\"11\" font-weight=\"bold\" fill=\"#042414\">alert</text>\n\n        <circle cx=\"210\" cy=\"220\" r=\"8\" fill=\"#0d47a1\" />\n        <text x=\"210\" y=\"242\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"bold\" fill=\"#042414\">status</text>\n\n        <circle cx=\"80\" cy=\"145\" r=\"8\" fill=\"#042414\" />\n        <text x=\"66\" y=\"149\" text-anchor=\"end\" font-size=\"11\" font-weight=\"bold\" fill=\"#042414\">user8 (本機)</text>\n      </svg>\n    </div>\n\n    <div class=\"shiftr-pub-panel\">\n      <div class=\"shiftr-col-title\" style=\"margin-bottom:6px;\">\n        <span>建立訊息發布系統 (user8)</span>\n        <span>Topic: AIOT/user8/message/{類別}</span>\n      </div>\n      <div class=\"shiftr-row\">\n        <input class=\"shiftr-input\" type=\"text\" ng-model=\"customText\" placeholder=\"輸入要廣播給全班的訊息內容...\" />\n      </div>\n      <div class=\"shiftr-row\" style=\"margin-bottom:0; justify-content: flex-end;\">\n        <button class=\"shiftr-btn btn-ann\" ng-click=\"publishMsg('announcement')\">發布公告 (announcement)</button>\n        <button class=\"shiftr-btn btn-alt\" ng-click=\"publishMsg('alert')\">發布警報 (alert)</button>\n        <button class=\"shiftr-btn btn-sta\" ng-click=\"publishMsg('status')\">發布狀態 (status)</button>\n      </div>\n    </div>\n  </div>\n\n  <div>\n    <div class=\"shiftr-col-title\">\n      <span>Active Connections</span>\n      <span>{{data.users.length}} online</span>\n    </div>\n    <div class=\"shiftr-card\" ng-repeat=\"u in data.users\">\n      <div class=\"shiftr-val\" style=\"font-size:13px;\">{{u.name}}</div>\n      <div class=\"shiftr-meta\">已發送 {{u.msgCount}} 則 &nbsp;|&nbsp; {{u.lastSeen}}</div>\n    </div>\n    <div class=\"shiftr-card\" ng-if=\"data.users.length === 0\">\n      <div class=\"shiftr-val\" style=\"font-size:13px;\">user8</div>\n      <div class=\"shiftr-meta\">待發送或接收全班訊息</div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(scope) {\n  scope.customText = '';\n  scope.data = {\n    history: [],\n    users: [],\n    counts: { announcement: 0, alert: 0, status: 0, total: 0 }\n  };\n\n  scope.$watch('msg', function(msg) {\n    if (msg && msg.payload && msg.payload.history) {\n      scope.data = msg.payload;\n    }\n  });\n\n  scope.publishMsg = function(category) {\n    let text = scope.customText;\n    if (!text || text.trim() === '') {\n      if (category === 'announcement') text = '【全班公告】來自 user8 的廣播訊息！';\n      if (category === 'alert') text = '【緊急警報】user8 發出警報測試！';\n      if (category === 'status') text = '【系統狀態】user8 已上線運作。';\n    }\n    scope.send({\n      topic: 'AIOT/user8/message/' + category,\n      payload: text\n    });\n    scope.customText = '';\n  };\n})(scope);\n</script>",
