    {
        "id": "func_exec_b",
        "type": "function",
        "z": "tab_project_b_ui",
        "name": "[B 組] 模擬設備執行並回傳",
        "func": "const cmd = msg.payload;\nlet state = flow.get('ledState') || { power: 'OFF', brightness: 0 };\n\nif (typeof cmd === 'string') {\n    if (cmd.toUpperCase() === 'ON') {\n        state.power = 'ON';\n        state.brightness = state.brightness > 0 ? state.brightness : 100;\n    } else if (cmd.toUpperCase() === 'OFF') {\n        state.power = 'OFF';\n        state.brightness = 0;\n    }\n} else if (typeof cmd === 'object' && cmd !== null && cmd.brightness !== undefined) {\n    state.brightness = Number(cmd.brightness);\n    state.power = state.brightness > 0 ? 'ON' : 'OFF';\n}\n\nflow.set('ledState', state);\nnode.status({\n    fill: state.power === 'ON' ? 'green' : 'grey',\n    shape: 'dot',\n    text: `${state.power} (${state.brightness}%)`\n});\n\nmsg.topic = 'AIOT/user2/status/led';\nmsg.payload = {\n    power: state.power,\n    brightness: state.brightness,\n    timestamp: new Date().toLocaleTimeString('zh-TW', { hour12: false })\n};\nreturn msg;",
