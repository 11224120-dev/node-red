    {
        "id": "mqtt_in_all",
        "type": "mqtt in",
        "z": "tab_smart_classroom",
        "name": "訂閱所有組別感測器",
        "topic": "AIOT/+/sensor/#",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "broker_aiot",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 400,
        "wires": [
            [
                "func_parse_classroom",
                "debug_sub_raw"
            ]
        ]
    },
    {
        "id": "func_parse_classroom",
        "type": "function",
        "z": "tab_smart_classroom",
        "name": "解析組別/教室與感測類型",
        "func": "// Topic 格式: AIOT/{user}/sensor/{type}\nconst parts = msg.topic.split('/');\nconst group = parts[1] || 'unknown';\nconst sensorType = parts[3] || 'unknown';\n\n// 儲存各組最新狀態於 flow context\nlet classrooms = flow.get('classrooms') || {};\nif (!classrooms[group]) {\n    classrooms[group] = {};\n}\nclassrooms[group][sensorType] = msg.payload;\nclassrooms[group].updatedAt = new Date().toLocaleTimeString('zh-TW', { hour12: false });\nflow.set('classrooms', classrooms);\n\nmsg.group = group;\nmsg.sensorType = sensorType;\nmsg.summary = `[${group}] ${sensorType}: ${msg.payload}`;\nmsg.allClassrooms = classrooms;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 400,
        "wires": [
            [
                "switch_group",
                "debug_summary"
            ]
        ]
    },
    {
        "id": "switch_group",
        "type": "switch",
        "z": "tab_smart_classroom",
        "name": "依教室(組別)分流",
        "property": "group",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "user1",
                "vt": "str"
            },
