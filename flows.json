    {
        "id": "func_execute_device",
        "type": "function",
        "z": "tab_project_b",
        "name": "模擬 LED 設備執行",
        "func": "// 解析 A 組發送的控制指令\nconst cmd = msg.payload;\nlet deviceState = flow.get('ledState') || { power: 'OFF', brightness: 0 };\n\nif (typeof cmd === 'string') {\n    const upper = cmd.toUpperCase();\n    if (upper === 'ON') {\n        deviceState.power = 'ON';\n        deviceState.brightness = deviceState.brightness || 100;\n    } else if (upper === 'OFF') {\n        deviceState.power = 'OFF';\n        deviceState.brightness = 0;\n    }\n} else if (typeof cmd === 'object' && cmd !== null) {\n    if (cmd.brightness !== undefined) {\n        deviceState.brightness = cmd.brightness;\n        deviceState.power = cmd.brightness > 0 ? 'ON' : 'OFF';\n    }\n    if (cmd.room) {\n        deviceState.room = cmd.room;\n    }\n}\n\nflow.set('ledState', deviceState);\n\n// 設定節點狀態燈號顯示\nnode.status({\n    fill: deviceState.power === 'ON' ? 'green' : 'grey',\n    shape: 'dot',\n    text: `LED: ${deviceState.power} (${deviceState.brightness}%)`\n});\n\n// 準備回傳給 A 組的狀態訊息\nmsg.topic = 'AIOT/user2/status/led';\nmsg.payload = {\n    device: 'LED',\n    power: deviceState.power,\n    brightness: deviceState.brightness,\n    room: deviceState.room || 'Default',\n    timestamp: new Date().toLocaleTimeString('zh-TW', { hour12: false })\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 380,
        "wires": [
