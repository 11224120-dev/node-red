    {
        "id": "func_sim_temp",
        "type": "function",
        "z": "tab_smart_classroom",
        "name": "模擬溫度感測器 (20~30°C)",
        "func": "// 模擬教室溫度 (22.0 ~ 28.0 °C)\nconst temp = (22 + Math.random() * 6).toFixed(1);\nmsg.payload = parseFloat(temp);\nmsg.topic = \"AIOT/user1/sensor/temperature\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 120,
        "wires": [
            [
                "mqtt_out_temp",
                "debug_pub"
            ]
        ]
    },
    {
        "id": "func_sim_hum",
        "type": "function",
        "z": "tab_smart_classroom",
        "name": "模擬濕度感測器 (40~70%)",
        "func": "// 模擬教室濕度 (40 ~ 70 %)\nconst hum = Math.round(40 + Math.random() * 30);\nmsg.payload = hum;\nmsg.topic = \"AIOT/user1/sensor/humidity\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 180,
        "wires": [
            [
                "mqtt_out_hum",
                "debug_pub"
            ]
        ]
    },
